# Application
NODE_ENV=development
API_PORT=5000

# Platform Database (tenants, users, subscriptions, billing, audit)
DB_PLATFORM_HOST=localhost
DB_PLATFORM_PORT=5432
DB_PLATFORM_NAME=platform
DB_PLATFORM_USER=postgres
DB_PLATFORM_PASS=password

# Tenant Database (schema-per-tenant: documents, dashboards, settings)
DB_TENANT_HOST=localhost
DB_TENANT_PORT=5432
DB_TENANT_NAME=tenant
DB_TENANT_USER=postgres
DB_TENANT_PASS=password

# Database Options
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-secret-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Auth
IS_DISABLE_AUTH=false
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_ENABLED=true

# Serverless
IS_NOT_SLS=true

# Logging
IS_LOGGING_ENABLED=true
